# Preserve accepted source bytes and SHA-256 values; no Phase A line conversion.
* -text
*.cpp diff=cpp
*.h diff=cpp
*.exe binary
*.dll binary
*.ico binary
*.png binary
*.xz binary
# PowerShell 5.1 and MSYS2 accept LF. Freeze this script's existing LF policy;
# no repository-wide normalization or change to historical script logic.
scripts/online-msys2.ps1 text eol=lf
