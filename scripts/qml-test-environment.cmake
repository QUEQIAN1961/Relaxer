# Resolve installed imports from the selected Declarative components, not the
# base Qt's compiled-in QLibraryInfo paths (which can point outside an overlay).
function(relaxer_configure_qml_tests)
  set(candidates)
  foreach(component Qml Quick QuickControls2)
    if(DEFINED Qt6${component}_DIR)
      get_filename_component(prefix "${Qt6${component}_DIR}/../../.." ABSOLUTE)
      list(APPEND candidates "${prefix}/qml" "${prefix}/share/qt6/qml" "${prefix}/lib/qt6/qml")
    endif()
    foreach(config RELEASE RELWITHDEBINFO DEBUG NOCONFIG)
      get_target_property(location Qt6::${component} IMPORTED_LOCATION_${config})
      if(location AND EXISTS "${location}")
        get_filename_component(libdir "${location}" DIRECTORY)
        list(APPEND candidates "${libdir}/../qml" "${libdir}/../share/qt6/qml" "${libdir}/qt6/qml")
      endif()
    endforeach()
  endforeach()
  set(roots)
  set(quick_found FALSE)
  set(controls_found FALSE)
  foreach(candidate IN LISTS candidates)
    get_filename_component(candidate "${candidate}" REALPATH)
    if(EXISTS "${candidate}/QtQuick/qmldir")
      set(quick_found TRUE)
      list(APPEND roots "${candidate}")
    endif()
    if(EXISTS "${candidate}/QtQuick/Controls/qmldir")
      set(controls_found TRUE)
      list(APPEND roots "${candidate}")
    endif()
  endforeach()
  list(REMOVE_DUPLICATES roots)
  if(NOT quick_found OR NOT controls_found)
    message(FATAL_ERROR "Selected Qt Declarative has no usable QtQuick/Controls import root. Checked: ${candidates}")
  endif()
  set(RELAXER_QML_TEST_IMPORT_ROOTS "${roots}" CACHE INTERNAL "Validated import roots of selected Qt Declarative" FORCE)
  message(STATUS "Relaxer QML test imports (selected Declarative): ${roots}")
endfunction()

function(relaxer_qml_test_environment test)
  foreach(root IN LISTS RELAXER_QML_TEST_IMPORT_ROOTS)
    set_property(TEST ${test} APPEND PROPERTY ENVIRONMENT_MODIFICATION
      "QML_IMPORT_PATH=path_list_prepend:${root}")
  endforeach()
  if(WIN32)
    # A clean runner must also resolve the actual DLLs of split Qt prefixes.
    foreach(component Core Qml Quick QuickControls2)
      set_property(TEST ${test} APPEND PROPERTY ENVIRONMENT_MODIFICATION
        "PATH=path_list_prepend:$<TARGET_FILE_DIR:Qt6::${component}>")
    endforeach()
  endif()
  set_property(TEST ${test} APPEND PROPERTY ENVIRONMENT "QT_QUICK_BACKEND=software")
endfunction()
