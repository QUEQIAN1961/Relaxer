if(NOT DEFINED RELAXER_TEST_EXECUTABLE OR NOT DEFINED RELAXER_OBJDUMP)
  message(FATAL_ERROR "The shortcut rules test executable and objdump are required")
endif()
execute_process(COMMAND "${RELAXER_OBJDUMP}" -p "${RELAXER_TEST_EXECUTABLE}"
  RESULT_VARIABLE result OUTPUT_VARIABLE imports ERROR_VARIABLE error)
if(NOT result STREQUAL "0")
  message(FATAL_ERROR "Could not inspect shortcut rules test dependencies: ${error}")
endif()
foreach(required Core Gui Test)
  if(NOT imports MATCHES "Qt6${required}d?[.](dll|so)")
    message(FATAL_ERROR "The isolated shortcut rules test does not import Qt6${required}: ${imports}")
  endif()
endforeach()
if(imports MATCHES "Qt6(Widgets|Network|Sql|Multimedia[^ .\n]*|Svg[^ .\n]*|Quick[^ .\n]*|Qml[^ .\n]*)d?[.](dll|so)")
  message(FATAL_ERROR "The isolated shortcut rules test imports a forbidden Qt module: ${imports}")
endif()
message(STATUS "Shortcut rules link audit passed: Core/Gui/Test only; Widgets, Quick and Qml absent")
