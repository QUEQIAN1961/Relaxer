if(NOT DEFINED RELAXER_TEST_EXECUTABLE OR NOT DEFINED RELAXER_OBJDUMP)
  message(FATAL_ERROR "PlaybackFacade executable and objdump are required")
endif()
execute_process(COMMAND "${RELAXER_OBJDUMP}" -p "${RELAXER_TEST_EXECUTABLE}"
  RESULT_VARIABLE result OUTPUT_VARIABLE imports ERROR_VARIABLE error)
if(NOT result STREQUAL "0")
  message(FATAL_ERROR "Could not inspect service: ${error}")
endif()
foreach(required Core Gui Sql Multimedia Test)
  if(NOT imports MATCHES "Qt6${required}d?[.](dll|so)")
    message(FATAL_ERROR "PlaybackFacade test is missing Qt6${required}")
  endif()
endforeach()
if(imports MATCHES "Qt6(Widgets|Svg[^ .\n]*|Quick[^ .\n]*|Qml[^ .\n]*)d?[.](dll|so)")
  message(FATAL_ERROR "PlaybackFacade links a forbidden UI module: ${imports}")
endif()
message(STATUS "PlaybackFacade link audit: no Widgets/Svg/Quick/Qml; inherited core dependencies allowed")
