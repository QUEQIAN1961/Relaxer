if(NOT DEFINED RELAXER_TEST_EXECUTABLE OR NOT DEFINED RELAXER_OBJDUMP)
  message(FATAL_ERROR "Lyrics search executable and objdump are required")
endif()
execute_process(COMMAND "${RELAXER_OBJDUMP}" -p "${RELAXER_TEST_EXECUTABLE}"
  RESULT_VARIABLE result OUTPUT_VARIABLE imports ERROR_VARIABLE error)
if(NOT result STREQUAL "0")
  message(FATAL_ERROR "Cannot inspect lyrics search service: ${error}")
endif()
foreach(required Core Sql Network Test)
  if(NOT imports MATCHES "Qt6${required}d?[.](dll|so)")
    message(FATAL_ERROR "Lyrics search service missing Qt6${required}")
  endif()
endforeach()
if(imports MATCHES "Qt6(Widgets|Svg[^ .\n]*|Quick[^ .\n]*|Qml[^ .\n]*)d?[.](dll|so)")
  message(FATAL_ERROR "Lyrics search service links forbidden UI module: ${imports}")
endif()
message(STATUS "Lyrics searchCoordinator link audit passed: no Widgets/Svg/Quick/Qml")
